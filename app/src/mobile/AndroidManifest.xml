<?xml version="1.0" encoding="utf-8"?>
<!--
  ZH Play Mobile: the phone app without the TV-only power features.
  These are what Google Play Protect treats as risky for apps from outside the Play Store,
  and the phone doesn't need them (they only matter on the TV).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <application>
        <!-- control other apps (TV remote) -->
        <service android:name="com.mytv.player.TvAccess" tools:node="remove" />
        <!-- read other apps' "now playing" (TV) -->
        <service android:name="com.mytv.player.MediaWatch" tools:node="remove" />
        <!-- start with the TV -->
        <receiver android:name="com.mytv.player.BootReceiver" tools:node="remove" />
    </application>
</manifest>
